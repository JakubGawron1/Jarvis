# Copy to .env — never commit secrets.

# Local Bionic / LM Studio (OpenAI-compatible)
JARVIS_LOCAL_LLM_URL=http://127.0.0.1:1234/v1
JARVIS_LOCAL_LLM_MODEL=local-model

# OpenRouter free-tier fallback (LLM + TTS)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
# Render/cloud speech: Fish S2.1 Pro Free (PL+EN). EN default is Flux TTS free (British male).
OPENROUTER_TTS_MODEL=fish-audio/s2.1-pro-free:free
OPENROUTER_TTS_MODEL_EN=deepgram/flux-tts:free
OPENROUTER_TTS_VOICE_EN=flux-sean-en

# Cloud pairing — HUD/Flutter already have the Render token built in.
# JARVIS_PAIRING_TOKEN=
JARVIS_BIND=127.0.0.1:7420
# HUD cloud fallback is built-in (jarvis-core-n12s). Override only if the service name changes.
# JARVIS_CLOUD_WS=wss://jarvis-core-n12s.onrender.com/ws

# Mesh federation — desktop jarvisd dials Render so a phone on cloud sees this PC.
# Default: wss://jarvis-core-n12s.onrender.com/ws   |   off to disable
# JARVIS_MESH_PEERS=
# JARVIS_CLOUD_PAIRING_TOKEN=

# Turso (shared memory when online)
TURSO_URL=
TURSO_AUTH_TOKEN=

# Voice binaries (optional). Empty = Windows SAPI / espeak-ng fallback.
# Piper: powershell -File scripts\setup-voice.ps1  (then restart jarvisd)
WHISPER_BIN=
PIPER_BIN=
PIPER_VOICE_PL=
PIPER_VOICE_EN=
KOKORO_URL=
